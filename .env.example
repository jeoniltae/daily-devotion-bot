# 로컬 개발용 환경변수 템플릿.
# 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 는 절대 커밋하지 않는다.
# GitHub Actions 에서는 이 값들을 Secrets 로 주입한다. (CLAUDE.md 8장)

# 텔레그램 봇 토큰 — @BotFather 에서 발급
TELEGRAM_BOT_TOKEN=

# 발송 대상 채널 ID — -100 으로 시작하는 숫자
# 로컬에는 반드시 "테스트 채널" ID 를 넣는다. 실채널 ID 는 Secrets 에만 둔다.
TELEGRAM_CHANNEL_ID=

# 구글 스프레드시트 ID — 시트 URL 의 /d/ 와 /edit 사이 문자열
GOOGLE_SHEET_ID=

# 구글 서비스 계정 키 파일 경로 — secrets/ 아래에 둔다 (.gitignore 로 차단됨)
GOOGLE_APPLICATION_CREDENTIALS=secrets/service-account.json
