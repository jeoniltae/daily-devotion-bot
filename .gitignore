# ─────────────────────────────────────────────
# 자격증명 (최우선 — 커밋되면 회수 불가)
# CLAUDE.md 8장 참고. 실제 값은 GitHub Secrets에만 둔다.
# ─────────────────────────────────────────────

# 환경변수
.env
.env.*
!.env.example

# 구글 서비스 계정 키 (다운로드 시 파일명이 제각각이라 넓게 막는다)
secrets/
credentials*.json
service-account*.json
*-service-account*.json
client_secret*.json
gcp-*.json

# 기타 키·인증서
*.pem
*.p12
*.key

# ─────────────────────────────────────────────
# 의존성 · 빌드 산출물
# ─────────────────────────────────────────────

node_modules/
dist/
*.tsbuildinfo
*.tgz

# ─────────────────────────────────────────────
# 로그 · 테스트 · 캐시
# ─────────────────────────────────────────────

logs/
*.log
npm-debug.log*
coverage/
*.lcov
.npm
.eslintcache

# ─────────────────────────────────────────────
# 에디터 · OS
# ─────────────────────────────────────────────

.vscode/
.idea/
.claude/settings.local.json

# Windows
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store

# ─────────────────────────────────────────────
# 대시보드 도입 시 (3단계, 아직 없음)
# ─────────────────────────────────────────────

.vite/
vite.config.ts.timestamp-*
